rcado por toda a infraestrutura que o Água Verde oferece.","fotos":["https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/1f62f912-f016-4053-add4-c30264b44ab9.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/18110a72-d005-4f30-a5d6-a2ab6c29a6a6.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/3ec94587-f963-48ae-99e4-25757c16d787.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/da97b154-5c35-4d88-b4d4-79d1b9c1e9b5.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/0a88cc05-fa07-40b6-b5dd-9b52b3aba183.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/034bdb65-c383-4a8a-9163-5e8c6982e3d9.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/c581d70e-41bc-4fa0-9fbf-916cae8749ab.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/94a850d2-a32d-4db1-bcb4-388da5a21b54.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/f216cb05-9c04-40e7-addc-5468b1dc9474.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/8ee2b418-39f4-41ea-a15d-ff4e2dcce5e7.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/67d150d9-4b9b-4a60-aa87-1d2839ee4322.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/c50569a9-15fe-496d-877d-070047f411d6.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a7a821b7824e2c3deafb544/pilar-homes-images-watermark/e74ac7de-e6d6-4bd4-85c1-acf39839cf6a.j