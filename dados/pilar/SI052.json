ão, próximo a serviços, escolas, parques e com fácil acesso às principais vias.","fotos":["https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/265b3f03-0417-4833-befc-4f26991835e9.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/57a88ca5-ce12-4d2d-b671-03641bfa67f3.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/3c2e55a6-f6a6-4fc4-ab2f-509d4c4f1996.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/44efe12d-22c8-4cdb-bfed-cab19cb4b068.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/4bc268bc-1183-4fe8-b189-10767912c861.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/cb0da4bf-3361-4716-9547-4d904778b373.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/4313cdaa-31dc-4d5b-bba1-42f2ed07a91c.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/14c67994-952f-4830-b3dd-127d9f3af308.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/e6a96b3e-180c-4e06-8864-63f448177c06.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/1e9e0b67-2042-49f9-a13c-30f82fcb9b91.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/c46c7334-2a54-4e93-86ae-77510d9a427d.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/86d419a7-ca84-48ae-b8b1-e5d225646188.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68feda752b8410875bb45824/pilar-homes-images-watermark/07bd7a3f-e48a-4b