iba. Um endereço que alia praticidade, sofisticação e qualidade de vida.","fotos":["https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/006c016a-43df-489d-8857-1f94587c1ba4.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/e1ef8bcd-3ad0-47b9-93a4-201b02794e45.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/67d0520f-5dc9-433a-8873-0533c8a04645.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/41d10ff6-e03d-4b8f-9dd9-c99346047385.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/5da6754e-ea43-43dc-8b01-db648136be54.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/31fcb3dd-d263-4fe7-a339-bd87c7e8b979.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/3cfb6e87-0cf8-488a-a4fb-0152f446e27d.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/ce361bd5-47e1-4af6-8624-6eaecf67e195.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/76a82524-40b2-446f-a68a-2138400133b8.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/c2029ec8-aeaf-4fb2-bd01-6981643104a9.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/49e50d95-5b1b-4722-9c7d-b380d20ba35b.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/0939ae59-c481-4e46-8c60-4cd424ebffd5.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/696aae3148e0031ee34e283f/pilar-homes-images-watermark/f405ced1-ff40-4998-ab07