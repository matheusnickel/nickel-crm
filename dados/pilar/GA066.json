os.”","fotos":["https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/61f29bb9-4116-498c-9479-34d8efeab737.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/1ed7a508-8d36-4db6-9515-a30a68faa94d.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/7591998b-5e0c-44bf-852c-1f2774cd636a.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/5abd9015-6838-44ec-b6b5-28b4e967d10f.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/d3af2fcb-475e-40b9-8372-0add1853707d.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/0884b2ac-21f4-4acb-83a6-07cce59cd47f.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/5137a377-db6f-4a31-baa0-f758a602f4e4.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/abee6705-913f-480b-8e77-3f4f212caf5d.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/28abb419-52d9-4514-bbd7-c5d602bc077c.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/a761144b-3405-42d6-b19d-7e8251dc321b.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/4ce06d70-7005-490e-9f2b-d94a27fc4726.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/f2751b2d-0547-4f17-ad15-3be8aec5b112.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/68ec5ce591fb5ac61c0788a9/pilar-homes-images-watermark/db649a36-8722-481d-a2cd-34a67d126235.jpeg","https://blintz-properties-sandbox.s3.amazonaws.