 privilegiada.","fotos":["https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/361a6733-53d5-4ba4-915b-ef88701d1a3e.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/54ee7131-9262-46e5-be63-18297266d270.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/21a74fcd-a470-4388-b915-baa003abb83a.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/6479fa5e-0670-459a-989d-30e3d332202d.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/b011b383-502f-4c63-9421-8bb330ced793.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/70c3aeaf-4c96-497e-8635-456265fc5f59.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/0a4f8927-e772-4dfa-92c6-cea2768a6051.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/64898400-e9db-4801-b68d-33a90ff490bc.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/514d7bac-1ffa-4a26-9c1e-2c9038099639.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/9fc2d5b3-c966-46e4-9488-015c06f6de85.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/59b52dd4-2dca-4556-8a49-a72796010e8f.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/bc980b05-bef4-43e7-99ae-33f2ba143e30.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6a9c27243bc88f11a9ecf36d/pilar-homes-images-watermark/1b33cfec-2071-4e68-9a62-c9f9ba87ac99.jpeg","https://blintz-properties-sandbox.s3.