os podem sofrer alterações sem aviso prévio.","fotos":["https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/70c45c13-3158-4e85-a370-df55ebd4b1a2.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/2338308e-5e6e-434a-8747-fa5d889275ce.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/09704da4-af31-4153-91f3-04685fc0f602.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/fe08a41d-f1be-421c-a06b-319a7b2675e6.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/3d513dd5-6907-42af-a99f-e7c02f6304ec.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/eba74d93-77ff-4d7e-ac26-3f507af89258.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/74c4307e-8d32-43a7-9592-99e2b8ee1a5a.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/ce973474-ab04-4241-bcff-2f667c570b17.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/988dba4e-3e1d-43db-b4ca-375284e19f40.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/1b6ffb73-ced2-4e0c-b5d9-0ea4f2075071.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/b5b99b64-f570-4589-a13f-ba4083364bc6.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/7d04f5e6-cf26-429d-8e58-178f001f8a4b.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69cb1f55d8ed8c9ad98788d0/pilar-homes-images-watermark/4fea3162-e226-460c-bf4e-90e60b35f17e.jpeg","https:/