ita.","fotos":["https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/80b70f0f-c996-43d6-808a-3c4366c418d4.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/ce40c5e6-85a8-4df3-8ce6-fdd1a7a1bc1a.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/0947baa1-e6bf-48ad-bb88-95da659beb87.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/57cd0825-ab19-4d41-a9b9-12cb5de92231.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/ae6268be-12e6-4f28-9c59-43721c91a07a.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/2c9d0b7b-5c83-4b4b-98d1-100327de3748.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/f3f35907-a02f-492a-85d9-3d15117f4637.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/f9551848-2555-4453-8272-20e550687e70.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/f88ab156-f069-47c8-9259-818a4dd7dcb4.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/aa049f82-1c87-455c-8278-fb866929def2.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/47d8c163-5962-4fca-90d7-e0bdac61c2c4.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/8a945be5-1297-4621-927d-7e25ab1aaf7c.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/6ab56ef7af3d5835a20c8910/pilar-homes-images-watermark/c815a0f8-4d9b-44fe-bb58-38b33a8e91b1.jpeg","https://blintz-properties-sandbox.s3.amazonaws.