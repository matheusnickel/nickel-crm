dade.\n\nResidência averbada.","fotos":["https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/ad83ee1d-9a24-4a53-b42e-661cb1c6a37f.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/6e318788-d88b-4c9d-a26b-59dc40e9ad4d.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/6d5995d1-a8f1-4823-9784-7e36b649431b.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/1dfbd01a-9067-4ee1-9364-b88b1d36dc11.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/2448e95d-245c-4abf-bfbb-6398cce17377.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/0dbf9d6b-fa12-455d-92ec-68f9fa97c921.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/840c76f3-d40d-4cd0-bb4d-5f53c653c46d.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/9fdae18c-d251-43ac-991f-760293495d7b.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/f7664465-8de9-4993-bb51-dd2c3fd662c2.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/c3b1cd96-a6e6-4440-b783-fa9fcd533961.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/474695da-99ec-4f59-82df-066ed05d4b23.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/e70752a9-661c-45b0-8db1-c7820f37dfa2.jpeg","https://blintz-properties-sandbox.s3.amazonaws.com/69bd5ca4c5f1426176cc5142/pilar-homes-images-watermark/514e955e-9d02-4244-b76d-fee765d0ae46.jpeg","https://blintz-propert