oveiscuritiba #altopadraocuritiba #moraremcuritiba25:[\"$\",\"$L29\",null,{\"details\":{\"id\":\"93d3e575-a7df-","fotos":["https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223500/sheep%20-%20IMG_8350-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223447/sheep%20-%20IMG_8341-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223448/sheep%20-%20IMG_8343-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223451/sheep%20-%20IMG_8346-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223506/sheep%20-%20IMG_8351-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223521/sheep%20-%20IMG_8356-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223522/sheep%20-%20IMG_8358-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223530/sheep%20-%20IMG_8361_1-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223444/sheep%20-%20IMG_8344_1-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223543/sheep%20-%20IMG_8366_1-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223422/sheep%20-%20IMG_8387_1-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223422/sheep%20-%20IMG_8389_1-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223431/sheep%20-%20IMG_8394_1-watermarked.webp","https://d3873uwf1n1xlo.cloudfront.net/CRM_WebP/MY%20BROKER%20CURITIBA/uploads/20260622223432/sheep%20-%20IMG_8396_1-watermarked.webp","h