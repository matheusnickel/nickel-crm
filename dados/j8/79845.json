idade e uma localização privilegiada."],"destaques":[],"fotos":["https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3ef1112543.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3ef200aab0.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3ef6076a0e.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3eedc09ffa.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3ef5006508.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3ef3105bc6.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3ef40064c1.jpg","https://j8.com.br/vista.imobi/fotos/79845/ibin23_798456ac4025d611ec.jpg","https://j8.com.br/vista.imobi/fotos/79845/iUv4363P2_798456ac405fa196a2.jpg","https://j8.com.br/vista.imobi/fotos/79845/iv6D3rx5193fn4J9tQ_798456ac404f31ce1c.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3eecb0ec7e.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3ef6f06737.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3ef8002ccd.jpg","https://j8.com.br/vista.imobi/fotos/79845/ibin23_798456ac40251db74b.jpg","https://j8.com.br/vista.imobi/fotos/79845/ibin23_798456ac4023aa02ac.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3ef9207ba7.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3efce04f48.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3efdf019ad.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3efeacfc15.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3efbef2018.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3f02728ee7.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3f033489ea.jpg","https://j8.com.br/vista.imobi/fotos/79845/ieyH64p6k32f3tiJ_798456ac3f041063b4.jpg","https://j8.com.br/vista.imobi/fotos/79